@model List<TripWise.Mvc.Models.TripViewModel>
@{
        ViewData["Title"] = "Your Trips";
}


<h2>Your Trips</h2>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Welcome to Your Dashboard</h2>
        <a asp-action="Create" class="btn btn-success">+ Plan New Trip</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You don't have any trips planned yet. Click the button above to get started!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var trip in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-primary">@trip.Title</h5>
                            <h6 class="card-subtitle mb-2 text-muted">📍 @trip.Destination</h6>
                            <p class="card-text text-secondary small">
                                📅 @trip.StartDate.ToString("dd MMM yyyy") - @trip.EndDate.ToString("dd MMM yyyy")
                            </p>
                            <p class="card-text mt-auto">
                                <span class="badge bg-secondary">@trip.Activities?.Count activities planned</span>
                            </p>
                            <div class="mt-3 d-flex justify-content-between">
                                <a asp-action="Details" asp-route-id="@trip.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@trip.Id" class="btn btn-light btn-sm text-warning">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@trip.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this trip?');" style="display:inline;">
                                        <button type="submit" class="btn btn-light btn-sm text-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
