@model TripWise.Mvc.Models.TripViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="jumbotron bg-light p-4 rounded shadow-sm mb-4">
        <h1 class="display-4 text-primary">@Model.Title</h1>
        <p class="lead"><strong>Destination Target:</strong> 📍 @Model.Destination</p>
        <p class="text-muted">📅 Timeline: @Model.StartDate.ToShortDateString() to @Model.EndDate.ToShortDateString()</p>
        <hr class="my-4">
        <a asp-controller="Activities" asp-action="Create" asp-route-tripId="@Model.Id" class="btn btn-primary">+ Add New Activity</a>
    </div>

    <h3 class="mb-3">Planned Itinerary Activities</h3>

    @if (Model.Activities == null || !Model.Activities.Any())
    {
        <div class="alert alert-warning">
            No events or custom locations have been assigned to this itinerary group yet.
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var act in Model.Activities.OrderBy(a => a.StartTime))
            {
                <div class="list-group-item list-group-item-action flex-column align-items-start p-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1 text-dark fw-bold">@act.Name</h5>
                        <small class="text-info font-monospace">⏱️ @act.StartTime.ToString("hh:mm tt")</small>
                    </div>
                    <p class="mb-1 text-secondary">@act.Description</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted">📍 Location context: <strong>@act.Location</strong></small>
                        <span class="badge bg-light text-dark font-monospace">🏷️ @act.Type</span>
                    </div>
                </div>
            }
        </div>
    }
</div>